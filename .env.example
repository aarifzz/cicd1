# ─────────────────────────────────────────────────────────────
# .env.example — copy to .env for local development
# NEVER commit real secrets. Use GitHub Secrets for CI/CD.
# ─────────────────────────────────────────────────────────────

# App
NODE_ENV=development
PORT=3000
VERSION=local

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/appdb

# Redis
REDIS_URL=redis://localhost:6379

# Auth
APP_SECRET=change-me-to-a-long-random-string-in-production
JWT_EXPIRY=7d

# AWS (for DB snapshots — prod only)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BACKUP_BUCKET=your-backups-bucket

# Slack notifications
SLACK_WEBHOOK=https://hooks.slack.com/services/XXX/YYY/ZZZ

# Feature flags
FEATURE_NEW_DASHBOARD=false
FEATURE_BETA_API=false
